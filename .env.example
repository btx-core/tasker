# Semua variabel yang dibaca aplikasi. TIDAK ADA RAHASIA ASLI di berkas ini.
# Salin ke .env lalu isi. Aplikasi berhenti saat start bila yang WAJIB kosong.

# WAJIB
DATABASE_URL=postgres://kelindan:kelindan@localhost:5432/kelindan
SESSION_SECRET=ganti-dengan-32-byte-acak-jangan-pakai-ini
APP_URL=http://localhost:3000
NODE_ENV=development

# OPSIONAL (punya default aman)
# PORT=3001
# LOG_LEVEL=info
# STORAGE_DRIVER=filesystem
# EMAIL_MODE=none
