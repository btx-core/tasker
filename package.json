{
  "name": "kelindan",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node packages/db/dist/cli.js migrate",
    "migrate:dry-run": "node packages/db/dist/cli.js migrate --dry-run",
    "lint:boundary": "node scripts/lint-boundary.mjs",
    "verify": "node scripts/build.mjs && npm run lint && npm run lint:boundary && npm run bundle:check && npm test",
    "build:web": "esbuild apps/web/src/main.ts --bundle --format=esm --outfile=apps/web/public/main.js --target=es2022 --minify",
    "dev": "npm run build:web && node --experimental-strip-types apps/server/src/dev-server.ts",
    "bundle:check": "node scripts/bundle-check.mjs",
    "lint:ui": "eslint apps/web",
    "pg:up": "bash scripts/realpg.sh",
    "drill:restore": "bash scripts/restore-drill.sh",
    "drill:self-test": "bash scripts/restore-drill.sh --self-test",
    "test:realpg": "KELINDAN_PG_URL=postgres://postgres@127.0.0.1:5432/kelindan_test vitest run packages/db/src/tasks/concurrency.realpg.test.ts packages/db/src/auth packages/server/src/ws packages/server/src/db-pool.realpg.test.ts packages/server/src/http/pool-http.realpg.test.ts",
    "verify:ci": "npm ci && node scripts/build.mjs && npm run lint && npm run lint:boundary && npm run bundle:check && npm test",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.10",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pg": "^8.13.1",
    "pg-protocol": "^1.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
